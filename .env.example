# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real tokens/hosts.

# Which config/<env>.yaml file to load. One of: dev, staging, prod
PIPELINE_ENV=dev

# Databricks Connect — used by the local VSCode session to reach the
# serverless cluster. (Often also configured via `databricks auth login`
# / a Databricks Connect profile instead — keep whichever mechanism you're
# actually using, this is documentation either way.)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Later phases (Postgres serving layer, FastAPI) will add:
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
